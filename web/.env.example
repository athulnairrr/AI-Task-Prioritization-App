# Web dashboard environment variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Base URL of the FastAPI backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase project credentials (anon/public key only - safe for client use)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google OAuth client id used for Google Calendar / Sign-in on web
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
