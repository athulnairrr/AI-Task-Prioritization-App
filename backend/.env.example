# Backend environment variables
# Copy this file to .env and fill in real values. Never commit .env.

APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated list of allowed CORS origins
CORS_ALLOW_ORIGINS=http://localhost:3000

# Supabase / Postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# JWKS endpoint used to verify Supabase-issued JWTs (asymmetric ES256/RS256
# signing keys). Always ${SUPABASE_URL}/auth/v1/.well-known/jwks.json.
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# Prefer the Supabase connection pooler (port 6543) over the direct :5432
# connection -- Supabase's direct host may be IPv6-only depending on your
# network. URL-encode any special characters in the password (e.g. @ -> %40).
DATABASE_URL=postgresql://postgres.your-project-ref:your-encoded-password@aws-0-your-region.pooler.supabase.com:6543/postgres

# Gemini (task understanding/prioritization). Free tier -- get a key at
# https://aistudio.google.com/apikey. Without it, POST /tasks/{id}/prioritize
# returns a clean 502 rather than crashing; everything else still works.
GEMINI_API_KEY=your-gemini-api-key
# Model name lives in config, not hardcoded -- override here if needed.
GEMINI_MODEL=gemini-3.1-flash-lite

# Google Calendar (connect/view events/free-busy read-only by default;
# incremental OAuth upgrades a connection to the calendar.events write scope
# when the user taps "Apply to Google Calendar" -- no separate credentials
# needed for that, same OAuth client).
# See /docs/architecture.md "Google Calendar integration" for exact Google
# Cloud Console setup steps (OAuth client, redirect URI, no billing needed).
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
# Must exactly match a redirect URI registered on the Google Cloud OAuth client.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/calendar/callback

# Signs the OAuth `state` CSRF token (HS256). Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
OAUTH_STATE_SECRET=your-oauth-state-secret

# Encrypts Google refresh/access tokens before they're stored (Fernet).
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never commit this. Rotating it invalidates every stored connection (see
# app/core/crypto.py for the rotation tradeoffs).
TOKEN_ENCRYPTION_KEY=your-fernet-encryption-key

# Optional: two pre-existing demo/test Supabase Auth users (see
# database/seeds/seed.sql), used only by the live integration tests in
# tests/test_tasks.py. Leave blank to skip those tests (e.g. in CI).
TEST_DEMO_USER_A_EMAIL=
TEST_DEMO_USER_A_PASSWORD=
TEST_DEMO_USER_B_EMAIL=
TEST_DEMO_USER_B_PASSWORD=

# Optional: a manually-obtained Google refresh token that already has the
# calendar.events WRITE scope granted, used only by the one live/opt-in test
# in tests/test_schedule_apply_live_google.py (creates and deletes one real
# Calendar event). Leave blank to skip that test. See the test file's
# docstring for how to obtain a token (e.g. via OAuth Playground).
TEST_LIVE_CALENDAR_REFRESH_TOKEN=
TEST_LIVE_CALENDAR_ID=primary

# Two-way Calendar sync (Phase 7). Optional: a real public HTTPS URL Google
# can reach, pointing at this backend's /calendar/webhook route (e.g. a
# deployed backend, or an ngrok/similar tunnel in dev). Leave blank to skip
# push-notification registration entirely -- POST /calendar/sync (called on
# calendar-panel mount + a manual "Sync now" action) is a full $0-cost
# fallback with no functional loss beyond not being instant.
GOOGLE_CALENDAR_WEBHOOK_URL=
# How long a registered watch channel is requested to live before it must
# be renewed (Google channels can't be renewed in place).
CALENDAR_WATCH_TTL_DAYS=7
# Renew a channel once it's within this long of expiring (checked
# opportunistically -- no cron job exists in this app).
CALENDAR_WATCH_RENEW_WITHIN_HOURS=24
# Bounds for a *full* sync (no syncToken yet, or one just invalidated by a
# 410) -- kept narrow to stay well within Google's free quota rather than
# paging through someone's entire calendar history. An incremental sync
# (has a syncToken) is unbounded by these.
CALENDAR_SYNC_WINDOW_DAYS_PAST=7
CALENDAR_SYNC_WINDOW_DAYS_FUTURE=90
